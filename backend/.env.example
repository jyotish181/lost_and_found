# Server Configuration
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=lost_and_found
# (Optional) use a single URL instead of the DB_* values above, e.g. for hosted databases:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lost_and_found
# DB_SSL=true

# Cloudinary Configuration (Images) - optional, images fall back to local mode if empty
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (Cache & Rate Limiting) - optional, falls back to memory if not running
REDIS_URL=redis://localhost:6379
